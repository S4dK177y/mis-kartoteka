// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/database.sqlite"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("DOCTOR") // ADMIN, DOCTOR
  createdAt    DateTime @default(now())

  documents Document[]
  logs      AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // CREATE, UPDATE, DELETE, UPLOAD
  entity    String // Patient, Document, User
  entityId  String?
  details   String? // JSON stringified details
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Patient {
  id                   String    @id @default(uuid())
  personId             String?   @default(uuid()) // Объединяет разные госпитализации одного человека
  tokenNumber          String? // Личный номер (жетон)
  caseHistoryNumber    String? // Номер карты (истории болезни)
  rank                 String? // Звание
  militaryUnit         String? // № в/ч
  militaryStatus       String? // 'Призыв' или 'Контракт'
  isSvoParticipant     Boolean   @default(false)
  fullName             String
  birthDate            DateTime
  address              String?
  phoneNumber          String?
  relativeRelation     String? // Статус (жена, брат, друг и т.д.)
  relativeFullName     String? // ФИО близкого
  relativePhone        String? // Телефон близкого
  relativeAddress      String? // Адрес близкого
  admissionDiagnosis   String? // Диагноз при поступлении
  clinicalDiagnosis    String? // Клинический диагноз
  finalDiagnosis       String? // Заключительный диагноз
  complications        String? // Осложнения и сопутствующие
  department           String // Текущее отделение
  admissionDate        DateTime  @default(now())
  dischargeDate        DateTime? // Дата выписки
  dischargeDestination String? // Куда выписан/переведен
  status               String    @default("На лечении") // На лечении, Выписан, В архиве
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  documents Document[]
  transfers TransferHistory[]
}

model Document {
  id           String  @id @default(uuid())
  filename     String // Имя файла на диске (санитаризированное)
  originalName String // Оригинальное имя при загрузке
  mimeType     String
  size         Int
  patientId      String?
  consultationId String?
  personId       String? // Для связи со всеми госпитализациями человека
  uploadedById   String?

  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  uploader     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  vvkConclusion VvkConclusion?
}

model TransferHistory {
  id             String   @id @default(uuid())
  patientId      String
  fromDepartment String? // Из какого отделения (null, если это первичное поступление)
  toDepartment   String // В какое отделение
  transferDate   DateTime @default(now())
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Consultation {
  id                   String    @id @default(uuid())
  personId             String?
  tokenNumber          String?
  rank                 String?
  militaryUnit         String?
  militaryStatus       String?
  isSvoParticipant     Boolean   @default(false)
  fullName             String
  birthDate            DateTime?
  address              String?
  phoneNumber          String?
  relativeRelation     String?
  relativeFullName     String?
  relativePhone        String?
  relativeAddress      String?
  diagnosis            String?
  consultationDate     DateTime  @default(now())
  nextConsultationDate DateTime?
  notes                String?
  doctorId             String?
  type                 String    @default("REGULAR") // REGULAR, VVK
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  documents     Document[]
  vvkConclusion VvkConclusion?
}

model VvkConclusion {
  id                      String   @id @default(uuid())
  consultationId          String   @unique
  status                  String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  neurologistCategory     String?
  ophthalmologistCategory String?
  dentistCategory         String?
  surgeonCategory         String?
  therapistCategory       String?
  
  finalCategory           String?
  medicalLeaveDays        Int?
  documentId              String?  @unique // Ссылка на скан заключения ВВК
  
  consultation            Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  document                Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

model Setting {
  key   String @id
  value String
}
